{
  "manifest_version": 3,
  "name": "My New Tab",
  "version": "1.0.0",
  "description": "A calm, custom new tab page with greeting, clock, and quick links.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
